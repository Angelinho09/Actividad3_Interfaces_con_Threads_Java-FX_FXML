<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="433.0" prefWidth="438.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.angeldz.hilos1.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <TextField fx:id="txtConteo" />
      <Button mnemonicParsing="false" onAction="#accionContar" text="contar" />
      <Button fx:id="btnEsperar" mnemonicParsing="false" onAction="#accionEsperar" text="esperar" />
      <ProgressBar fx:id="barraProgreso" prefWidth="200.0" progress="0.0" />
   </children>
</VBox>
